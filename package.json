{
  "name": "gprose-engine-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:wasm": "node scripts/build-shaper.mjs",
    "build": "pnpm run setup && pnpm run check:project && tsc --noEmit && vite build",
    "test": "run-p --print-label test:vitest test:e2e",
    "test:vitest": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project 'browser-*'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup-assets.mjs && pnpm run build:wasm",
    "check:editor": "node scripts/check-editor.mjs",
    "check:editor-book": "node scripts/check-editor-book.mjs",
    "check:war-and-peace": "node scripts/check-war-and-peace.mjs",
    "check:editor-table": "node scripts/check-editor-table.mjs",
    "check:editor-large": "node scripts/check-editor-large.mjs",
    "benchmark:editor-large": "node scripts/benchmark-editor-large.mjs",
    "check:editor-reflow": "node scripts/check-editor-reflow.mjs",
    "benchmark:editor-reflow": "node scripts/benchmark-editor-reflow.mjs",
    "memory:editor": "node scripts/measure-editor-retention.mjs",
    "check:transactions": "node scripts/check-editor-transactions.mjs",
    "check:editor-boundaries": "node scripts/check-editor-boundaries.mjs",
    "benchmark:containers": "node scripts/benchmark-editor-containers.mjs",
    "check:editor-pointer": "node scripts/check-editor-pointer.mjs",
    "demo": "vite --host 127.0.0.1 --open /editor.html",
    "check:editor-cross-selection": "node scripts/check-editor-cross-selection.mjs",
    "check:editor-demo": "node scripts/check-editor-demo.mjs",
    "check:editor-page-scroll": "node scripts/check-editor-page-scroll.mjs",
    "check:editor-multiclick": "node scripts/check-editor-multiclick.mjs",
    "check:editor-samples": "node scripts/check-editor-samples.mjs",
    "check:text-commands": "node scripts/check-text-commands.mjs",
    "check:editor-blocks": "node scripts/check-editor-blocks.mjs",
    "check:editor-distant-edit": "node scripts/check-editor-distant-edit.mjs",
    "check:editor-outline": "node scripts/check-editor-outline.mjs",
    "check:editor-toolbar": "node scripts/check-editor-toolbar.mjs",
    "check:editor-headings": "node scripts/check-editor-headings.mjs",
    "check:editor-tables": "node scripts/check-editor-tables.mjs",
    "check:editor-find-core": "node scripts/check-editor-find-core.mjs",
    "check:editor-find": "node scripts/check-editor-find.mjs",
    "benchmark:editor-find": "node scripts/benchmark-editor-find.mjs",
    "benchmark:editor-loading": "node scripts/benchmark-editor-loading.mjs",
    "benchmark:editor-paste": "node scripts/benchmark-editor-paste.mjs",
    "benchmark:editor-delete": "node scripts/benchmark-editor-delete.mjs",
    "check:editor-bulk-delete": "node scripts/check-editor-bulk-delete.mjs",
    "check:editor-id-allocation": "node scripts/check-editor-id-allocation.mjs",
    "check:editor-paste-reflow": "node scripts/check-editor-paste-reflow.mjs",
    "check:editor-select-all": "node scripts/check-editor-select-all.mjs",
    "check:editor-book-paste": "node scripts/check-editor-book-paste.mjs",
    "check:editor-rich-paste": "node scripts/check-editor-rich-paste.mjs",
    "check:editor-unicode": "node scripts/check-editor-unicode.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5176",
    "check:project": "node scripts/check-project.mjs && pnpm run check:editor-boundaries && pnpm run check:app-boundaries",
    "demo:extensions": "vite --host 127.0.0.1 --open /extensions.html",
    "check:editor-navigation": "node scripts/check-editor-navigation.mjs",
    "check:editor-foundation": "vitest run tests/foundation.test.js tests/foundation.browser.test.js",
    "benchmark:editor-foundation": "node scripts/benchmark-editor-foundation.mjs",
    "benchmark:schema-codecs": "node scripts/benchmark-schema-codecs.mjs",
    "benchmark:relative-positions": "node scripts/benchmark-relative-positions.mjs",
    "check:editor-performance": "node scripts/check-editor-performance.mjs",
    "check:app-boundaries": "node scripts/check-app-boundaries.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "run-p --print-label lint format:check typecheck check:project test"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "canvaskit-wasm": "0.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "5.0.1",
    "npm-run-all2": "8.0.4",
    "oxc-transform-react": "0.145.0",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "~5.9.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.14.0"
}
