{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "ES2022.Intl"],
    "strict": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "customConditions": ["gprose-source"]
  },
  "include": [
    "apps/*/src",
    "packages/*/src",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx",
    "vitest.config.ts"
  ]
}
